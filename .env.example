# Copia este archivo como .env y rellena lo que necesites. El .env no se sube a Git.

# Puerto del servidor local
PORT=4321

# Carpeta con tus agentes .md (también puedes pasarla con --agentes al arrancar)
# Ejemplo en Windows: C:\Users\tu-usuario\Desktop\mi-proyecto\.claude\agents
AGENTES_DIR=./agentes

# Opcional: para chatear con los héroes. Créala en console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo para el chat (rápido y barato)
CHAT_MODEL=claude-haiku-5-5
